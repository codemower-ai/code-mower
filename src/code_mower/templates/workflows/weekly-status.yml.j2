# Code Mower workflow template: refresh a pinned weekly status issue.
name: Code Mower weekly status

on:
  schedule:
    - cron: __WEEKLY_STATUS_CRON__
  workflow_dispatch:
    inputs:
      status_issue:
        description: "Pinned status issue number; overrides owner_surface.status_issue."
        required: false

permissions:
  contents: read
  issues: write
  pull-requests: read

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: "true"
  STATUS_ISSUE: __STATUS_ISSUE__
  NEEDS_OWNER_LABEL: __NEEDS_OWNER_LABEL_YAML__
  OWNER_DECISION_LABEL: __OWNER_DECISION_LABEL_YAML__
  OWNER_SITTING_LABEL: __OWNER_SITTING_LABEL_YAML__
  READY_LABEL: __READY_LABEL__
  PHASE_LABELS: __PHASE_LABELS__
  REVIEWER_SPEND_PATH: __REVIEWER_SPEND_PATH__
  REVIEWER_VALUE_REPORT_PATH: __REVIEWER_VALUE_REPORT_PATH__

jobs:
  report:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
        with:
          python-version: "3.12"
      - name: Generate and post
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
          STATUS_ISSUE_INPUT: {% raw %}${{ github.event.inputs.status_issue }}{% endraw %}
        run: |
          set -euo pipefail

          status_issue="${STATUS_ISSUE_INPUT:-${STATUS_ISSUE}}"
          if [ -z "${status_issue}" ] || [ "${status_issue}" = "TODO_STATUS_ISSUE" ]; then
            echo "::notice::Skipping Code Mower weekly status; set owner_surface.status_issue or dispatch with status_issue."
            exit 0
          fi

          python3 tools/status_report.py > /tmp/code-mower-status.md
          gh issue edit "${status_issue}" --repo "${REPO}" --body-file /tmp/code-mower-status.md
          gh issue comment "${status_issue}" --repo "${REPO}" --body-file /tmp/code-mower-status.md
