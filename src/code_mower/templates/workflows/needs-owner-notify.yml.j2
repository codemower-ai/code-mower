# Code Mower workflow template: notify a human owner on decision labels.
name: Code Mower owner notify

on:
  issues:
    types: [labeled]
  pull_request:
    types: [labeled]

permissions:
  issues: write
  pull-requests: write

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: "true"
  NEEDS_OWNER_LABEL: __NEEDS_OWNER_LABEL_YAML__
  OWNER_DECISION_LABEL: __OWNER_DECISION_LABEL_YAML__
  OWNER_SITTING_LABEL: __OWNER_SITTING_LABEL_YAML__
  GATE_OVERRIDE_LABEL: __GATE_OVERRIDE_LABEL_YAML__
  OWNER_LOGIN: __OWNER_LOGIN_YAML__
  OWNER_LOGIN_OVERRIDE: {% raw %}${{ vars.CODE_MOWER_OWNER_LOGIN || '' }}{% endraw %}

jobs:
  notify:
    runs-on: ubuntu-latest
    timeout-minutes: 3
    steps:
      - name: Assign owner and mention
        if: >-
          github.event.label.name == env.NEEDS_OWNER_LABEL ||
          github.event.label.name == env.OWNER_DECISION_LABEL ||
          github.event.label.name == env.OWNER_SITTING_LABEL ||
          github.event.label.name == env.GATE_OVERRIDE_LABEL
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
          NUM: {% raw %}${{ github.event.issue.number || github.event.pull_request.number }}{% endraw %}
          LABEL: {% raw %}${{ github.event.label.name }}{% endraw %}
          ACTOR: {% raw %}${{ github.actor }}{% endraw %}
          KIND: {% raw %}${{ github.event_name == 'issues' && 'issue' || 'pull request' }}{% endraw %}
        run: |
          set -euo pipefail

          owner_login="${OWNER_LOGIN_OVERRIDE:-${OWNER_LOGIN}}"
          mention="repository owner"
          if [ -n "${owner_login:-}" ] && [ "${owner_login}" != "TODO_OWNER_LOGIN" ]; then
            gh api -X POST "repos/${REPO}/issues/${NUM}/assignees" \
              -f "assignees[]=${owner_login}" || \
              echo "::warning::Could not assign ${owner_login} on #${NUM}; token may be read-only."
            mention="@${owner_login}"
          fi

          if [ "${LABEL}" = "${NEEDS_OWNER_LABEL}" ]; then
            body="${mention} - decision requested on this ${KIND} (labeled by ${ACTOR}). Keep it in the owner queue only after the ask includes: Options, Recommendation, and Existing decision touched. If an accepted ADR, operating model, or issue decision already answers it, the orchestration lane may resolve it here, record the resolution, and remove ${NEEDS_OWNER_LABEL}."
          elif [ -n "${OWNER_DECISION_LABEL:-}" ] && [ "${LABEL}" = "${OWNER_DECISION_LABEL}" ]; then
            body="${mention} - owner decision is ready on this ${KIND} (labeled by ${ACTOR}). Confirm the ask includes Options, Recommendation, and Existing decision touched; otherwise send it back to orchestration before deciding."
          elif [ -n "${OWNER_SITTING_LABEL:-}" ] && [ "${LABEL}" = "${OWNER_SITTING_LABEL}" ]; then
            body="${mention} - owner sitting needed on this ${KIND} (labeled by ${ACTOR}). Code Mower keeps this out of builder WIP until the physical step is done."
          else
            body="${mention} - ${GATE_OVERRIDE_LABEL} was applied by ${ACTOR}. Only the owner should override a gate; log the reason in this thread."
          fi
          gh api -X POST "repos/${REPO}/issues/${NUM}/comments" \
            -f "body=${body}" || \
            echo "::warning::Could not comment on #${NUM}; token may be read-only."
