# Code Mower workflow template: dispatch local CLI audits on a self-hosted runner.
#
# The workflow checks out trusted support scripts from the default branch and
# the pull request head as separate read-only audit context. It only runs for
# same-repository pull requests because local provider CLIs execute on the
# runner user's machine.
name: Code Mower Local CLI Audits

on:
__LOCAL_AUDIT_LEGACY_TRIGGER__
  repository_dispatch:
    types: [code-mower-local-review]

permissions:
  actions: read
  # repository_dispatch publication uses only this short-lived workflow token.
  contents: write
  issues: write
  pull-requests: write

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: "true"
  CODE_MOWER_LOCAL_AUDIT_PATH: "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

jobs:
  prepare:
    if: vars.__LOCAL_AUDIT_RUNNER_ENABLED_VAR__ == 'true'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
    outputs:
      ready: {% raw %}${{ steps.validate.outputs.ready }}{% endraw %}
      pr_number: {% raw %}${{ steps.validate.outputs.pr_number }}{% endraw %}
      head_sha: {% raw %}${{ steps.validate.outputs.head_sha }}{% endraw %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: {% raw %}${{ github.sha }}{% endraw %}
          persist-credentials: false
      - name: Validate requested review against the current PR
        id: validate
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: python3 tools/audit_publication.py prepare-review

  audit:
    name: audit ({% raw %}${{ matrix.lane.lane }}{% endraw %})
    needs: prepare
    if: >-
      vars.__LOCAL_AUDIT_RUNNER_ENABLED_VAR__ == 'true' &&
      needs.prepare.outputs.ready == 'true'
    runs-on: [self-hosted, macOS, __LOCAL_AUDIT_RUNNER_LABEL__]
    timeout-minutes: 90
    strategy:
      fail-fast: false
      matrix:
        lane: __LOCAL_AUDIT_LANES_JSON__
    concurrency:
      group: {% raw %}${{ github.workflow }}-${{ needs.prepare.outputs.pr_number }}-${{ needs.prepare.outputs.head_sha }}-${{ matrix.lane.lane }}{% endraw %}
      cancel-in-progress: true
    env:
      PR_NUMBER: {% raw %}${{ needs.prepare.outputs.pr_number }}{% endraw %}
      PR_HEAD_SHA: {% raw %}${{ needs.prepare.outputs.head_sha }}{% endraw %}
      PR_HEAD_PATH: {% raw %}${{ github.workspace }}/pr-head{% endraw %}
      SUPPORT_PATH: {% raw %}${{ github.workspace }}/code-mower-support{% endraw %}
      CODE_MOWER_LOCAL_AUDIT_LANE: {% raw %}${{ matrix.lane.lane }}{% endraw %}
      CODE_MOWER_AUDIT_STAGE_PATH: {% raw %}${{ github.workspace }}/audit-publication-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.lane.lane }}.json{% endraw %}
    steps:
      - name: Verify local runner environment
        run: |
          set -euo pipefail
          missing=0
          for name in USER LOGNAME SHELL LANG; do
            if [ -z "${!name:-}" ]; then
              echo "::error::Missing ${name}; set it in the self-hosted runner .env file."
              missing=1
            fi
          done
          if [ "${missing}" -ne 0 ]; then
            exit 1
          fi
          echo "Using Code Mower runner label __LOCAL_AUDIT_RUNNER_LABEL__"

      - name: Check out trusted Code Mower support files from default branch
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: {% raw %}${{ github.sha }}{% endraw %}
          path: code-mower-support
          persist-credentials: false

      - name: Reset pull request checkout path
        run: |
          set -euo pipefail
          rm -rf "${PR_HEAD_PATH}"

      - name: Check out pull request head
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: {% raw %}${{ needs.prepare.outputs.head_sha }}{% endraw %}
          path: pr-head
          fetch-depth: 0
          persist-credentials: false

      - name: Verify pull request checkout
        id: verify_pr_head
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          set -euo pipefail
          export PATH="${CODE_MOWER_LOCAL_AUDIT_PATH}:${PATH}"
          actual_head="$(git -C "${PR_HEAD_PATH}" rev-parse HEAD)"
          if [ "${actual_head}" != "${PR_HEAD_SHA}" ]; then
            echo "::error::PR checkout resolved ${actual_head}, expected ${PR_HEAD_SHA}"
            exit 1
          fi
          if ! current_head="$(
            gh api "repos/${GITHUB_REPOSITORY}/pulls/${PR_NUMBER}" \
              --jq '.head.sha'
          )"; then
            echo "::warning::Unable to verify current PR head via gh api; continuing with checkout head ${PR_HEAD_SHA}."
            current_head="${PR_HEAD_SHA}"
          fi
          if [ "${current_head}" != "${PR_HEAD_SHA}" ]; then
            echo "::notice::PR #${PR_NUMBER} head moved to ${current_head}; this run for ${PR_HEAD_SHA} is superseded."
            echo "superseded=true" >> "${GITHUB_OUTPUT}"
          else
            echo "superseded=false" >> "${GITHUB_OUTPUT}"
          fi

      - name: Run matching local CLI audits
        id: run_audit
        if: >-
          steps.verify_pr_head.conclusion == 'success' &&
          steps.verify_pr_head.outputs.superseded != 'true'
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          CODE_MOWER_REVIEWER_SPEND_PATH: {% raw %}${{ runner.temp }}/code-mower-reviewer-spend.json{% endraw %}
__LOCAL_AUDIT_TOKEN_ENV_ASSIGNMENTS__
          CODE_MOWER_LOCAL_AUDIT_LANE: {% raw %}${{ matrix.lane.lane }}{% endraw %}
          CODE_MOWER_LOCAL_AUDIT_DISPLAY_NAME: {% raw %}${{ matrix.lane.display_name }}{% endraw %}
          CODE_MOWER_LOCAL_AUDIT_NEEDS_LABEL: {% raw %}${{ matrix.lane.needs_label }}{% endraw %}
          CODE_MOWER_LOCAL_AUDIT_TOKEN_ENV: {% raw %}${{ matrix.lane.token_env }}{% endraw %}
          CODE_MOWER_LOCAL_AUDIT_SCRIPT: {% raw %}${{ matrix.lane.script }}{% endraw %}
          CLAUDE_AUDIT_MAX_BUDGET_USD: {% raw %}${{ matrix.lane.audit_budget_usd }}{% endraw %}
          CLAUDE_AUDIT_MAX_DIFF_BYTES: {% raw %}${{ matrix.lane.audit_max_diff_bytes }}{% endraw %}
          CLAUDE_AUDIT_MAX_DIFF_HARD_LIMIT_BYTES: {% raw %}${{ matrix.lane.audit_max_diff_hard_limit_bytes }}{% endraw %}
          CODEX_AUDIT_MAX_BUDGET_USD: {% raw %}${{ matrix.lane.audit_budget_usd }}{% endraw %}
          CODEX_AUDIT_MAX_DIFF_BYTES: {% raw %}${{ matrix.lane.audit_max_diff_bytes }}{% endraw %}
          CODEX_AUDIT_MAX_DIFF_HARD_LIMIT_BYTES: {% raw %}${{ matrix.lane.audit_max_diff_hard_limit_bytes }}{% endraw %}
        run: |
          set -euo pipefail
          export PATH="${CODE_MOWER_LOCAL_AUDIT_PATH}:${PATH}"

          # Only Claude/Codex use authenticated default-branch publication.
          case "${CODE_MOWER_LOCAL_AUDIT_LANE}:${GITHUB_EVENT_NAME}" in
            codex:repository_dispatch|claude:repository_dispatch|devin_cli:pull_request_target) ;;
            *) echo "audited=false" >> "${GITHUB_OUTPUT}"; exit 0 ;;
          esac

          labels_file="${RUNNER_TEMP}/code-mower-local-audit-labels.txt"
          gh pr view "${PR_NUMBER}" \
            --repo "${GITHUB_REPOSITORY}" \
            --json labels \
            --jq '.labels[].name' > "${labels_file}"

          has_label() {
            grep -Fxq "$1" "${labels_file}"
          }

          if ! has_label "${CODE_MOWER_LOCAL_AUDIT_NEEDS_LABEL}"; then
            echo "No ${CODE_MOWER_LOCAL_AUDIT_NEEDS_LABEL} label is present for ${CODE_MOWER_LOCAL_AUDIT_DISPLAY_NAME}."
            echo "audited=false" >> "${GITHUB_OUTPUT}"
            exit 0
          fi

          wrapper="${SUPPORT_PATH}/${CODE_MOWER_LOCAL_AUDIT_SCRIPT}"
          if [ ! -x "${wrapper}" ]; then
            echo "::error::Missing executable audit wrapper: ${CODE_MOWER_LOCAL_AUDIT_SCRIPT}"
            exit 1
          fi

          case "${CODE_MOWER_LOCAL_AUDIT_LANE}" in
            codex|claude) token="${GITHUB_TOKEN:-}"
                         unset DISPATCH_TOKEN "${CODE_MOWER_LOCAL_AUDIT_TOKEN_ENV}"
                         rm -f "${CODE_MOWER_AUDIT_STAGE_PATH}" ;;
            *) token="${!CODE_MOWER_LOCAL_AUDIT_TOKEN_ENV:-}"
               token="${token:-${GITHUB_TOKEN:-}}" ;;
          esac
          if [ -z "${token}" ]; then
            echo "::error::No GitHub token available for ${CODE_MOWER_LOCAL_AUDIT_DISPLAY_NAME} audit"
            exit 1
          fi

          echo "Running ${CODE_MOWER_LOCAL_AUDIT_DISPLAY_NAME} local CLI audit for PR #${PR_NUMBER}"
          echo "audited=true" >> "${GITHUB_OUTPUT}"
          # PR_HEAD_PATH was checked out and verified at PR_HEAD_SHA above.
          # Code Mower's PR-head fetch helper skips the private pull/N/head
          # fetch when --repo-paths already points at that exact head.
          # Provider text must not be interpreted as runner workflow commands.
          command_guard="$(python3 -c 'import secrets; print(secrets.token_hex(32))')"
          echo "::stop-commands::${command_guard}"
          audit_status=0
          umask 077
          audit_log="${RUNNER_TEMP}/code-mower-reviewer-${GITHUB_RUN_ID}-${CODE_MOWER_LOCAL_AUDIT_LANE}.log"
          printf '%s\n' "${token}" | "${wrapper}" \
            --read-token-from-stdin \
            --repo "${GITHUB_REPOSITORY}" \
            --pr "${PR_NUMBER}" \
            --repo-paths "${GITHUB_REPOSITORY}:${PR_HEAD_PATH}" > "${audit_log}" 2>&1 || audit_status=$?
          echo "::${command_guard}::"
          # PASS/BLOCKED finish successfully; failures cannot reach the seal.
          exit "${audit_status}"

      - name: Validate staged reviewer metadata
        id: prepare_seal
        if: >-
          steps.run_audit.outputs.audited == 'true' &&
          (matrix.lane.lane == 'codex' || matrix.lane.lane == 'claude')
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: python3 "${SUPPORT_PATH}/tools/audit_publication.py" prepare-seal

      - name: Code Mower reviewer seal {% raw %}${{ steps.prepare_seal.outputs.digest }}{% endraw %}
        if: steps.prepare_seal.outputs.digest != ''
        run: 'true'

      - name: Publish verified local audit and wait
        if: steps.prepare_seal.outputs.digest != ''
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: python3 "${SUPPORT_PATH}/tools/audit_publication.py" submit-staged

      - name: Upload Code Mower audit metadata
        if: >-
          always() &&
          steps.verify_pr_head.conclusion == 'success' &&
          steps.verify_pr_head.outputs.superseded != 'true' &&
          steps.run_audit.outputs.audited == 'true'
        env:
          CODE_MOWER_CLOUD_TOKEN: {% raw %}${{ secrets.CODE_MOWER_CLOUD_TOKEN }}{% endraw %}
          CODE_MOWER_CLOUD_TEAM_ID: {% raw %}${{ vars.CODE_MOWER_CLOUD_TEAM_ID }}{% endraw %}
          CODE_MOWER_INSTALL_ID: {% raw %}${{ vars.CODE_MOWER_INSTALL_ID }}{% endraw %}
          CODE_MOWER_REVIEWER_SPEND_PATH: {% raw %}${{ runner.temp }}/code-mower-reviewer-spend.json{% endraw %}
        run: |
          set -euo pipefail
          export PATH="${CODE_MOWER_LOCAL_AUDIT_PATH}:${PATH}"

          if [ -z "${CODE_MOWER_CLOUD_TOKEN:-}" ]; then
            echo "::notice::CODE_MOWER_CLOUD_TOKEN is not configured; skipping audit metadata upload."
            exit 0
          fi

          install_id="${CODE_MOWER_INSTALL_ID:-github-actions-local-cli-audit}"
          repo_cache_slug="${GITHUB_REPOSITORY//\//__}"
          verdict_dir="${HOME}/.cache/code-mower-audits/verdicts/${repo_cache_slug}/pr-${PR_NUMBER}"
          upload_failed=0

          "${SUPPORT_PATH}/tools/code_mower" cloud reviewer-runs \
            --repo-path "${PR_HEAD_PATH}" \
            --repo-slug "${GITHUB_REPOSITORY}" \
            --verdicts "${verdict_dir}" \
            --spend "${CODE_MOWER_REVIEWER_SPEND_PATH}" \
            --output-dir "${RUNNER_TEMP}/code-mower-reviewer-runs" \
            --install-id "${install_id}" \
            --include-git-ref \
            --yes \
            --json || upload_failed=1

          event_args=()
          work_order_dir="${SUPPORT_PATH}/.code-mower/work-orders"
          if [ -d "${work_order_dir}" ]; then
            while IFS= read -r -d '' event_file; do
              event_args+=(--event "work_order=${event_file}")
            done < <(find "${work_order_dir}" -type f -name '*.cloud-event.json' -print0)
          fi

          "${SUPPORT_PATH}/tools/code_mower" cloud dogfood \
            --repo-path "${SUPPORT_PATH}" \
            --repo-slug "${GITHUB_REPOSITORY}" \
            --source local-cli-audit \
            --output-dir "${RUNNER_TEMP}/code-mower-dogfood" \
            --install-id "${install_id}" \
            --yes \
            --json \
            ${event_args[@]+"${event_args[@]}"} || upload_failed=1

          if [ "${upload_failed}" -ne 0 ]; then
            echo "::warning::Code Mower audit metadata upload failed; audit verdict remains authoritative."
          fi
