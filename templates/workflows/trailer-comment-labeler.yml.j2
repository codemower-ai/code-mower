# Code Mower workflow template: apply labels from trusted audit-result comments.
name: __WORKFLOW_NAME__

on:
  issue_comment:
    types: [created, edited]

permissions:
  actions: write
  contents: read
  issues: write
  pull-requests: write

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: "true"
  CODE_MOWER_DECISION_AUTHORITIES: __DECISION_AUTHORITIES__
  CODE_MOWER_AUTHOR_EXCLUSION_JSON: __AUTHOR_EXCLUSION_JSON__

jobs:
  label:
    if: >-
      (
        github.event_name == 'issue_comment' &&
        github.event.issue.pull_request &&
        (
          (
            contains(',__BOT_AUTHORS__,', format(',{0},', github.event.comment.user.login)) &&
            (
              contains(github.event.comment.body, '__TRAILER_PREFIX__') ||
              contains(github.event.comment.body, '__DISPLAY_NAME__ Audit') ||
              contains(github.event.comment.body, 'HEAD_CHANGED_DURING_REVIEW') ||
              contains(github.event.comment.body, 'Label state:') ||
              contains(github.event.comment.body, 'Intended label state:') ||
              contains(github.event.comment.body, 'Expected labels:') ||
              contains(github.event.comment.body, 'Intended labels:') ||
              contains(github.event.comment.body, '__NEEDS_LABEL__') ||
              contains(github.event.comment.body, '__DONE_LABEL__') ||
              contains(github.event.comment.body, '__BLOCKED_LABEL__')
            )
          ) ||
          (
            contains(format(',{0},', vars.__AUTHORS_ENV__), format(',{0},', github.event.comment.user.login)) &&
            contains(github.event.comment.body, '__TRAILER_PREFIX__')
          )
        )
      )
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Check out Code Mower support files from default branch
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: {% raw %}${{ github.event.repository.default_branch }}{% endraw %}
          persist-credentials: false

      - name: Apply __DISPLAY_NAME__ audit labels
        env:
          GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          __LABEL_TOKEN_ENV__: {% raw %}${{ secrets.__LABEL_TOKEN_ENV__ }}{% endraw %}
          __AUTHORS_ENV__: {% raw %}${{ vars.__AUTHORS_ENV__ }}{% endraw %}
          TRAILER_LANE: __TRAILER_LANE__
          CODE_MOWER_GITHUB_ACTIONS_WORKFLOWS: "__GITHUB_ACTIONS_WORKFLOWS__"
        run: tools/code_mower trailer-comment-labeler --lane "${TRAILER_LANE}"

      - name: Recompute Code Mower gate
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          PR_NUMBER: {% raw %}${{ github.event.issue.number }}{% endraw %}
        run: |
          set -euo pipefail
          head_sha="$(gh api "repos/${GITHUB_REPOSITORY}/pulls/${PR_NUMBER}" --jq '.head.sha')"
          gh workflow run code-mower-gate.yml \
            --repo "${GITHUB_REPOSITORY}" \
            --ref {% raw %}"${{ github.event.repository.default_branch }}"{% endraw %} \
            -f "pr_number=${PR_NUMBER}" \
            -f "head_sha=${head_sha}"
