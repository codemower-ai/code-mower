# Code Mower workflow template: alert when audit gate infrastructure stalls.
name: Code Mower gate health

on:
  schedule:
    - cron: "__GATE_HEALTH_CRON__"
  workflow_dispatch:
    inputs:
      max_wait_minutes:
        description: "Minutes a needs-audit label may wait without a head-bound verdict."
        required: false

permissions:
  actions: read
  contents: read
  issues: write
  pull-requests: read

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: "true"
  CODE_MOWER_GATE_HEALTH_LANES_JSON: >-
    __GATE_HEALTH_LANES_JSON__
  CODE_MOWER_GATE_HEALTH_MAX_WAIT_MINUTES: {% raw %}${{ github.event.inputs.max_wait_minutes || '__GATE_HEALTH_MAX_WAIT_MINUTES__' }}{% endraw %}
  CODE_MOWER_LOCAL_AUDIT_WORKFLOW: local-cli-audit.yml
  CODE_MOWER_LOCAL_AUDIT_RUNNER_LABEL: "__LOCAL_AUDIT_RUNNER_LABEL__"
  CODE_MOWER_GATE_HEALTH_RUNNER_TOKEN: {% raw %}${{ secrets.CODE_MOWER_GATE_HEALTH_RUNNER_TOKEN || '' }}{% endraw %}
  NEEDS_OWNER_LABEL: "__NEEDS_OWNER_LABEL__"
  OWNER_LOGIN: "__OWNER_LOGIN__"
  STATUS_ISSUE: "__STATUS_ISSUE__"

jobs:
  health:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Check Code Mower gate health
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import json
          import os
          import re
          import subprocess
          import urllib.parse
          from datetime import datetime, timezone

          REPO = os.environ["REPO"]
          NEEDS_OWNER_LABEL = os.environ.get("NEEDS_OWNER_LABEL", "needs-owner")
          OWNER_LOGIN = os.environ.get("OWNER_LOGIN", "")
          STATUS_ISSUE = os.environ.get("STATUS_ISSUE", "")
          RUNNER_LABEL = os.environ.get("CODE_MOWER_LOCAL_AUDIT_RUNNER_LABEL", "")
          RUNNER_TOKEN = os.environ.get("CODE_MOWER_GATE_HEALTH_RUNNER_TOKEN", "")
          LOCAL_AUDIT_WORKFLOW = os.environ.get("CODE_MOWER_LOCAL_AUDIT_WORKFLOW", "")
          OWNER_PLACEHOLDERS = {"", "TODO_OWNER_LOGIN"}
          STATUS_PLACEHOLDERS = {"", "TODO_STATUS_ISSUE"}

          def gh_json(endpoint, token=""):
              env = os.environ.copy()
              if token:
                  env["GH_TOKEN"] = token
              output = subprocess.check_output(
                  ["gh", "api", endpoint],
                  env=env,
                  text=True,
              )
              return json.loads(output)

          def gh_pages(endpoint):
              output = subprocess.check_output(
                  ["gh", "api", "--paginate", "--slurp", endpoint],
                  text=True,
              )
              pages = json.loads(output)
              items = []
              for page in pages:
                  if isinstance(page, list):
                      items.extend(page)
              return items

          def gh(*args, check=True):
              return subprocess.run(["gh", *args], check=check, text=True)

          def parse_time(value):
              if not value:
                  return None
              return datetime.fromisoformat(str(value).replace("Z", "+00:00"))

          def minutes_since(value):
              created = parse_time(value)
              if created is None:
                  return 0
              return int((datetime.now(timezone.utc) - created).total_seconds() // 60)

          try:
              lanes = json.loads(os.environ.get("CODE_MOWER_GATE_HEALTH_LANES_JSON", "[]"))
          except json.JSONDecodeError:
              print("::error::CODE_MOWER_GATE_HEALTH_LANES_JSON is invalid")
              raise SystemExit(1)
          lanes = [lane for lane in lanes if isinstance(lane, dict)]
          needs_by_label = {
              str(lane.get("needs") or ""): lane
              for lane in lanes
              if str(lane.get("needs") or "")
          }
          if not needs_by_label:
              print("No Code Mower audit lanes configured for gate-health checks.")
              raise SystemExit(0)

          try:
              max_wait_minutes = int(os.environ.get("CODE_MOWER_GATE_HEALTH_MAX_WAIT_MINUTES", "30"))
          except ValueError:
              max_wait_minutes = 30

          def issue_comments(number):
              return gh_pages(f"repos/{REPO}/issues/{number}/comments?per_page=100")

          def has_marker(number, marker):
              for comment in issue_comments(number):
                  if marker in str(comment.get("body") or ""):
                      return True
              return False

          def trusted_authors(lane):
              raw = str(lane.get("bot_authors") or "")
              return {item.strip() for item in raw.split(",") if item.strip()}

          actions_run_re = re.compile(r"<!--\s*CODE_MOWER_AUDIT_RUN:\s*run_id=([0-9]+)\s*-->")
          actions_run_cache = {}

          def trusted_github_actions_workflows(lane):
              raw = str(lane.get("github_actions_workflows") or "")
              return {item.strip() for item in raw.split(",") if item.strip()}

          def actions_run(run_id):
              if run_id not in actions_run_cache:
                  try:
                      actions_run_cache[run_id] = gh_json(f"repos/{REPO}/actions/runs/{run_id}")
                  except subprocess.CalledProcessError:
                      actions_run_cache[run_id] = {}
              return actions_run_cache[run_id]

          def github_actions_comment_attested(lane, body, number, head_sha):
              workflows = trusted_github_actions_workflows(lane)
              if not workflows:
                  return False
              match = actions_run_re.search(body)
              if match is None:
                  return False
              run = actions_run(match.group(1))
              path = str(run.get("path") or "")
              if not path or not any(path == item or path.endswith("/" + item) for item in workflows):
                  return False
              if str(run.get("event") or "") != "pull_request_target":
                  return False
              pull_requests = run.get("pull_requests") or []
              if isinstance(pull_requests, list) and pull_requests:
                  for item in pull_requests:
                      if str(item.get("number") or "") != str(number):
                          continue
                      pr_head = str(((item.get("head") or {}).get("sha")) or "")
                      return not pr_head or pr_head == head_sha
                  return False
              return True

          def trusted_comment_author(lane, author, body, number, head_sha):
              authors = trusted_authors(lane)
              if author not in authors:
                  return False
              if author != "github-actions[bot]":
                  return True
              return github_actions_comment_attested(lane, body, number, head_sha)

          def has_head_bound_terminal(number, lane, head_sha):
              head_marker = "Head SHA: `" + head_sha + "`"
              labels = (str(lane.get("done") or ""), str(lane.get("blocked") or ""))
              suffixes = {": " + label + " -->" for label in labels if label}
              for comment in reversed(issue_comments(number)):
                  author = str(((comment.get("user") or {}).get("login")) or "")
                  body = str(comment.get("body") or "")
                  if not trusted_comment_author(lane, author, body, number, head_sha):
                      continue
                  if head_marker in body and any(suffix in body for suffix in suffixes):
                      return True
              return False

          def latest_label_event_minutes(number, label_name, fallback_updated_at):
              events = gh_pages(f"repos/{REPO}/issues/{number}/events?per_page=100")
              latest = None
              for event in events:
                  if event.get("event") != "labeled":
                      continue
                  label = event.get("label") or {}
                  if str(label.get("name") or "") != label_name:
                      continue
                  created = event.get("created_at")
                  if latest is None or str(created) > str(latest):
                      latest = created
              return minutes_since(latest or fallback_updated_at)

          def alert(number, marker, body):
              if has_marker(number, marker):
                  return
              gh("issue", "edit", str(number), "--repo", REPO, "--add-label", NEEDS_OWNER_LABEL, check=False)
              if OWNER_LOGIN not in OWNER_PLACEHOLDERS:
                  gh(
                      "api",
                      "-X",
                      "POST",
                      f"repos/{REPO}/issues/{number}/assignees",
                      "-f",
                      f"assignees[]={OWNER_LOGIN}",
                      check=False,
                  )
              gh(
                  "api",
                  "-X",
                  "POST",
                  f"repos/{REPO}/issues/{number}/comments",
                  "-f",
                  "body=" + body + "\n\n" + marker,
              )

          open_prs = gh_pages(f"repos/{REPO}/pulls?state=open&per_page=100")
          stale_prs = []
          for pr in open_prs:
              number = int(pr["number"])
              head_sha = str(((pr.get("head") or {}).get("sha")) or "")
              label_names = {
                  str(label.get("name") or "")
                  for label in pr.get("labels", [])
                  if isinstance(label, dict)
              }
              for needs_label, lane in needs_by_label.items():
                  if needs_label not in label_names:
                      continue
                  age_minutes = latest_label_event_minutes(
                      number,
                      needs_label,
                      pr.get("updated_at"),
                  )
                  if age_minutes <= max_wait_minutes:
                      continue
                  if has_head_bound_terminal(number, lane, head_sha):
                      continue
                  stale_prs.append((number, needs_label, lane, head_sha, age_minutes))
                  marker = (
                      "<!-- CODE_MOWER_GATE_HEALTH: "
                      f"needs:{number}:{needs_label}:{head_sha} -->"
                  )
                  body = (
                      f"@{OWNER_LOGIN} " if OWNER_LOGIN not in OWNER_PLACEHOLDERS else ""
                  ) + (
                      f"Code Mower gate health: PR #{number} has `{needs_label}` "
                      f"for about {age_minutes} minutes without a trusted, "
                      "head-bound terminal audit verdict. Check the local audit "
                      "runner or rerun the lane."
                  )
                  alert(number, marker, body)

          workflow_id = urllib.parse.quote(LOCAL_AUDIT_WORKFLOW, safe="")
          try:
              runs = gh_json(
                  f"repos/{REPO}/actions/workflows/{workflow_id}/runs?per_page=5"
              ).get("workflow_runs", [])
          except subprocess.CalledProcessError:
              runs = []
          for run in runs:
              if run.get("status") != "completed":
                  continue
              if run.get("conclusion") not in {"failure", "timed_out", "cancelled", "action_required"}:
                  continue
              prs = run.get("pull_requests") or []
              targets = [pr.get("number") for pr in prs if pr.get("number")]
              if not targets and STATUS_ISSUE not in STATUS_PLACEHOLDERS:
                  targets = [STATUS_ISSUE]
              for number in targets:
                  marker = f"<!-- CODE_MOWER_GATE_HEALTH: workflow:{run.get('id')} -->"
                  body = (
                      f"Code Mower gate health: `{LOCAL_AUDIT_WORKFLOW}` run "
                      f"{run.get('html_url')} finished with `{run.get('conclusion')}`. "
                      "Audit labels may be stuck until the workflow is fixed or rerun."
                  )
                  alert(number, marker, body)
              break

          if RUNNER_LABEL:
              try:
                  runners = gh_json(
                      f"repos/{REPO}/actions/runners?per_page=100",
                      token=RUNNER_TOKEN,
                  ).get("runners", [])
              except subprocess.CalledProcessError:
                  print("::warning::Could not inspect self-hosted runners.")
                  runners = None
                  targets = [item[0] for item in stale_prs]
                  if not targets and STATUS_ISSUE not in STATUS_PLACEHOLDERS:
                      targets = [STATUS_ISSUE]
                  for number in dict.fromkeys(targets):
                      marker = f"<!-- CODE_MOWER_GATE_HEALTH: runner-check-unavailable:{RUNNER_LABEL} -->"
                      body = (
                          "Code Mower gate health: could not inspect "
                          f"self-hosted runners for label `{RUNNER_LABEL}`. "
                          "Add `CODE_MOWER_GATE_HEALTH_RUNNER_TOKEN` with "
                          "repository Administration read access, or check "
                          "the runner manually."
                      )
                      alert(number, marker, body)
              if runners is not None:
                  online = False
                  for runner in runners:
                      labels = {
                          str(label.get("name") or "")
                          for label in runner.get("labels", [])
                          if isinstance(label, dict)
                      }
                      if RUNNER_LABEL in labels and runner.get("status") == "online":
                          online = True
                          break
              if runners is not None and not online:
                  targets = [item[0] for item in stale_prs]
                  if not targets and STATUS_ISSUE not in STATUS_PLACEHOLDERS:
                      targets = [STATUS_ISSUE]
                  for number in dict.fromkeys(targets):
                      marker = f"<!-- CODE_MOWER_GATE_HEALTH: runner-offline:{RUNNER_LABEL} -->"
                      body = (
                          f"Code Mower gate health: no self-hosted runner with "
                          f"label `{RUNNER_LABEL}` is currently online. Local CLI "
                          "audit lanes may not run until the runner is back."
                      )
                      alert(number, marker, body)

          print("Code Mower gate-health check complete.")
          PY
