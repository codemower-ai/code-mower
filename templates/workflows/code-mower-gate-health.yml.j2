# Code Mower workflow template: alert when audit gate infrastructure stalls.
name: Code Mower gate health

on:
  schedule:
    - cron: "__GATE_HEALTH_CRON__"
  workflow_dispatch:
    inputs:
      max_wait_minutes:
        description: "Minutes a needs-audit label may wait without a head-bound verdict."
        required: false
      liveness_minutes:
        description: "Minutes a blocked builder PR may wait without builder activity."
        required: false

permissions:
  actions: read
  checks: read
  contents: read
  issues: write
  pull-requests: read

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: "true"
  CODE_MOWER_GATE_HEALTH_LANES_JSON: >-
    __GATE_HEALTH_LANES_JSON__
  CODE_MOWER_GATE_HEALTH_MAX_WAIT_MINUTES: {% raw %}${{ github.event.inputs.max_wait_minutes || '__GATE_HEALTH_MAX_WAIT_MINUTES__' }}{% endraw %}
  CODE_MOWER_GATE_HEALTH_LIVENESS_MINUTES: {% raw %}${{ github.event.inputs.liveness_minutes || '__GATE_HEALTH_LIVENESS_MINUTES__' }}{% endraw %}
  CODE_MOWER_GATE_HEALTH_DEDUPE_HOURS: "6"
  CODE_MOWER_GATE_HEALTH_UNKNOWN_STREAK_THRESHOLD: "3"
  CODE_MOWER_GATE_HEALTH_UNKNOWN_STREAK_HISTORY_HOURS: "168"
  CODE_MOWER_GATE_HEALTH_UNKNOWN_STREAK_CLOSED_PR_LIMIT: "100"
  CODE_MOWER_LOCAL_AUDIT_RUNNER_LABEL: "__LOCAL_AUDIT_RUNNER_LABEL__"
  CODE_MOWER_GATE_HEALTH_RUNNER_TOKEN: {% raw %}${{ secrets.CODE_MOWER_GATE_HEALTH_RUNNER_TOKEN || '' }}{% endraw %}
  NEEDS_OWNER_LABEL: "__NEEDS_OWNER_LABEL__"
  OWNER_LOGIN: "__OWNER_LOGIN__"
  STATUS_ISSUE: "__STATUS_ISSUE__"

jobs:
  health:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Check out Code Mower support files from default branch
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10
        with:
          ref: {% raw %}${{ github.event.repository.default_branch }}{% endraw %}
          persist-credentials: false

      - name: Check Code Mower gate health
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
__GATE_HEALTH_AUTHOR_ENV_ASSIGNMENTS__
        run: |
          set -euo pipefail
          tools/code_mower gate-health \
            --repo "{% raw %}${{ github.repository }}{% endraw %}" \
            --status-issue "${STATUS_ISSUE}" \
            --stale-minutes "${CODE_MOWER_GATE_HEALTH_MAX_WAIT_MINUTES}" \
            --liveness-minutes "${CODE_MOWER_GATE_HEALTH_LIVENESS_MINUTES}" \
            --dedupe-hours "${CODE_MOWER_GATE_HEALTH_DEDUPE_HOURS}" \
            --unknown-streak-threshold "${CODE_MOWER_GATE_HEALTH_UNKNOWN_STREAK_THRESHOLD}" \
            --unknown-streak-history-hours "${CODE_MOWER_GATE_HEALTH_UNKNOWN_STREAK_HISTORY_HOURS}" \
            --unknown-streak-closed-pr-limit "${CODE_MOWER_GATE_HEALTH_UNKNOWN_STREAK_CLOSED_PR_LIMIT}" \
            --runner-label "${CODE_MOWER_LOCAL_AUDIT_RUNNER_LABEL}" \
            --owner-login "${OWNER_LOGIN}" \
            --alert-runner-api-unavailable
