# Legacy PR metadata cannot supply the trusted lineage inputs.
# Keep this compatibility workflow informational; explicit attribution belongs
# to the separately staged builder-lineage-producer.yml.j2 trusted caller.
name: Code Mower Builder Provenance

on:
  pull_request:
    types: [opened, edited, synchronize, reopened, ready_for_review]

permissions:
  contents: read

jobs:
  lineage-guidance:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Explain skipped automatic attribution
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p .code-mower
          cat > .code-mower/builder-provenance-guidance.json <<'JSON'
          {
            "mode": "builder-provenance-guidance",
            "status": "skipped",
            "reason": "Explicit trusted lineage target, policy, authority and observed transport are required.",
            "next_step": "Use the staged builder-lineage-producer.yml.j2 with a trusted caller."
          }
          JSON

      - name: Upload skipped attribution guidance
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: code-mower-builder-provenance-skipped
          path: .code-mower/builder-provenance-guidance.json
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 7
