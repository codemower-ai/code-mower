name: Code Mower Builder Provenance

on:
  pull_request:
    types: [opened, edited, synchronize, reopened, ready_for_review]

permissions:
  contents: read

env:
  CODE_MOWER_PACKAGE_SPEC: code-mower==0.6.0b3

jobs:
  auto-record:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Set up Python
        uses: actions/setup-python@8fc423ec5f48d6a2f5a10347eab979e8a63b7ab9
        with:
          python-version: "3.12"

      - name: Install Code Mower
        shell: bash
        run: |
          set -euo pipefail
          python -m pip install "${CODE_MOWER_PACKAGE_SPEC}"

      - name: Record inferred builder provenance
        id: record
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p .code-mower/builder-runs
          output=".code-mower/builder-runs/pr-{% raw %}${{ github.event.pull_request.number }}{% endraw %}.cloud-event.json"
          code-mower builder auto-record \
            --pr-json "${GITHUB_EVENT_PATH}" \
            --repo "${GITHUB_REPOSITORY}" \
            --output "${output}" \
            --force \
            --json | tee .code-mower/builder-auto-record.json
          if [ -s "${output}" ]; then
            echo "event_path=${output}" >> "${GITHUB_OUTPUT}"
          fi

      - name: Upload builder provenance artifact
        if: steps.record.outputs.event_path != ''
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: code-mower-builder-provenance
          path: |
            .code-mower/builder-auto-record.json
            {% raw %}${{ steps.record.outputs.event_path }}{% endraw %}
          if-no-files-found: error
          retention-days: 14

      - name: Upload inference summary for skipped PRs
        if: steps.record.outputs.event_path == ''
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: code-mower-builder-provenance-skipped
          path: .code-mower/builder-auto-record.json
          if-no-files-found: ignore
          retention-days: 7
